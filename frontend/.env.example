# Server-only. Base URL of the local DINOv2 inference service (services/dinov2-inference).
# Never referenced from client components — only from the /api/adoptante/photo-search route handler.
ADOPTER_DINOV2_SERVICE_URL=http://127.0.0.1:8000

# Server-only. Single demo account for the Protectora area (src/lib/protectora/auth.ts).
# Read only in the login route handler — never sent to the client, never logged.
PROTECTORA_DEMO_EMAIL=demo@invisibledogs.es
PROTECTORA_DEMO_PASSWORD=change-me
# HMAC-SHA256 secret used to sign the session cookie. Generate a real random
# value for any non-local environment, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROTECTORA_SESSION_SECRET=change-me
